@model List<LoginFormASPCore6.Models.CapacitySlotBooking>
@using LoginFormASPCore6.Models

@{
    ViewData["Title"] = "My Slot Bookings";
}

<div class="py-4">
    <h1 class="mb-4">My Slot Bookings</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <p class="mb-4"><a asp-action="Slots">Browse Slots</a></p>

    @if (!Model.Any())
    {
        <p class="text-muted">No upcoming slot bookings.</p>
    }

    @foreach (var booking in Model)
    {
        <div class="section-card mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h5 class="mb-1">@booking.CapacitySlot!.StartTime.ToString("f")</h5>
                    @if (booking.Status == CapacitySlotBookingStatus.Waitlisted)
                    {
                        <span class="status-badge status-pending">Waitlisted - #@booking.WaitlistPosition</span>
                    }
                    else
                    {
                        <span class="status-badge status-active">Booked</span>
                    }
                </div>
                <form asp-action="CancelSlotBooking" asp-route-id="@booking.Id" method="post">
                    <button type="submit" class="btn btn-outline-primary">Cancel</button>
                </form>
            </div>
        </div>
    }
</div>
