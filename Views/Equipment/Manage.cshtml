@model List<Equipment>

@{
    ViewData["Title"] = "Equipment";
    var currentRole = Context.Session.GetString("UserRole");
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"><i class="bi bi-tools"></i> Equipment</h1>
        <a asp-action="Create" class="btn btn-gradient">Add Equipment</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">No equipment registered yet.</p>
    }

    @foreach (var item in Model)
    {
        var statusClass = item.Status switch
        {
            EquipmentStatus.Active => "status-active",
            EquipmentStatus.Faulty => "status-faulty",
            EquipmentStatus.UnderMaintenance => "status-undermaintenance",
            _ => "status-inactive"
        };

        <div class="section-card mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div class="d-flex gap-3">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="~/@item.ImagePath" alt="@item.Name" class="rounded" style="width: 64px; height: 64px; object-fit: cover;" />
                    }
                    <div>
                        <h5 class="mb-1">@item.Name</h5>
                        <p class="form-text-hint mb-1">
                            @item.Category
                            @if (item.Venue != null)
                            {
                                @: · @item.Venue.Name
                            }
                            @if (!string.IsNullOrEmpty(item.SerialNumber))
                            {
                                @: · SN @item.SerialNumber
                            }
                        </p>
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <span class="status-badge @statusClass">@item.Status</span>
                            @if (item.Status == EquipmentStatus.Faulty && item.Severity != null)
                            {
                                <span class="status-badge severity-@item.Severity.ToString()!.ToLower()">@item.Severity Severity</span>
                            }
                        </div>
                        @if (item.Status == EquipmentStatus.Faulty)
                        {
                            <div class="mt-2">
                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <p class="mb-1">@item.Notes</p>
                                }
                                <p class="form-text-hint mb-1">Reported by @(item.ReportedByUser?.EmpName ?? "-") on @item.ReportedAt?.ToString("g")</p>
                                @if (!string.IsNullOrEmpty(item.DamagePhotoPath))
                                {
                                    <a href="~/@item.DamagePhotoPath" target="_blank">
                                        <img src="~/@item.DamagePhotoPath" alt="Damage photo" class="rounded" style="width: 80px; height: 80px; object-fit: cover;" />
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#details-@item.Id">Asset Details</button>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="PrintQr" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">QR Code</a>
                    @if (item.Status != EquipmentStatus.Faulty && item.Status != EquipmentStatus.Inactive)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#fault-@item.Id">Report Fault</button>
                    }
                    @if (item.Status == EquipmentStatus.Faulty)
                    {
                        <form asp-action="MarkUnderMaintenance" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Send for Maintenance</button>
                        </form>
                    }
                    @if (item.Status is EquipmentStatus.Faulty or EquipmentStatus.UnderMaintenance)
                    {
                        <form asp-action="MarkResolved" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Mark Resolved</button>
                        </form>
                    }
                    @if (item.Status != EquipmentStatus.Inactive)
                    {
                        <form asp-action="MarkInactive" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Mark Inactive</button>
                        </form>
                    }
                    @if (item.Status == EquipmentStatus.Inactive)
                    {
                        <form asp-action="MarkActive" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Reactivate</button>
                        </form>
                    }
                    @if (currentRole == "Admin" && item.Status == EquipmentStatus.Inactive)
                    {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Permanently delete this equipment? This cannot be undone.');">Delete</button>
                        </form>
                    }
                </div>
            </div>

            <div class="collapse mt-3" id="details-@item.Id">
                <div class="border-top pt-3">
                    @{
                        var hasAssetInfo = !string.IsNullOrEmpty(item.Supplier) || item.PurchaseDate != null || item.PurchasePrice != null
                            || item.WarrantyExpiryDate != null || !string.IsNullOrEmpty(item.InsuranceProvider)
                            || !string.IsNullOrEmpty(item.InsurancePolicyNumber) || item.InsuranceExpiryDate != null;
                    }
                    @if (!hasAssetInfo)
                    {
                        <p class="text-muted mb-0">No purchase or insurance details on record yet. <a asp-action="Edit" asp-route-id="@item.Id">Add some</a>.</p>
                    }
                    else
                    {
                        <div class="row">
                            @if (!string.IsNullOrEmpty(item.Supplier))
                            {
                                <div class="col-md-6 mb-1"><strong>Bought From:</strong> @item.Supplier</div>
                            }
                            @if (item.PurchaseDate != null)
                            {
                                <div class="col-md-6 mb-1"><strong>Purchase Date:</strong> @item.PurchaseDate.Value.ToString("d")</div>
                            }
                            @if (item.PurchasePrice != null)
                            {
                                <div class="col-md-6 mb-1"><strong>Purchase Price:</strong> R@(item.PurchasePrice.Value.ToString("N2"))</div>
                            }
                            @if (item.WarrantyExpiryDate != null)
                            {
                                <div class="col-md-6 mb-1">
                                    <strong>Warranty Expiry:</strong>
                                    <span class="@(item.WarrantyExpiryDate < DateTime.Today ? "text-danger" : "")">@item.WarrantyExpiryDate.Value.ToString("d")</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(item.InsuranceProvider))
                            {
                                <div class="col-md-6 mb-1"><strong>Insurance Provider:</strong> @item.InsuranceProvider</div>
                            }
                            @if (!string.IsNullOrEmpty(item.InsurancePolicyNumber))
                            {
                                <div class="col-md-6 mb-1"><strong>Policy Number:</strong> @item.InsurancePolicyNumber</div>
                            }
                            @if (item.InsuranceExpiryDate != null)
                            {
                                <div class="col-md-6 mb-1">
                                    <strong>Insurance Expiry:</strong>
                                    <span class="@(item.InsuranceExpiryDate < DateTime.Today ? "text-danger" : "")">@item.InsuranceExpiryDate.Value.ToString("d")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (item.Status != EquipmentStatus.Faulty && item.Status != EquipmentStatus.Inactive)
            {
                <div class="collapse mt-3" id="fault-@item.Id">
                    <form asp-action="ReportFault" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-end flex-wrap">
                        <input type="hidden" name="id" value="@item.Id" />
                        <div>
                            <label class="form-label">Severity</label>
                            <select name="severity" class="form-control">
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                        <div class="flex-grow-1">
                            <label class="form-label">Notes</label>
                            <input type="text" name="notes" class="form-control" placeholder="What's wrong?" />
                        </div>
                        <div>
                            <label class="form-label">Damage Photo (optional)</label>
                            <input type="file" name="damagePhotoFile" class="form-control" accept=".jpg,.jpeg,.png" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-gradient">Submit</button>
                    </form>
                </div>
            }
        </div>
    }
</div>
