@model Equipment
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Add Equipment";
}

<div class="py-4">
    <div class="section-card mx-auto" style="max-width: 640px;">
        <h1 class="mb-4">Add Equipment</h1>
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" placeholder="e.g. Cardio" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SerialNumber" class="form-label"></label>
                <input asp-for="SerialNumber" class="form-control" />
                <span asp-validation-for="SerialNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="VenueId" class="form-label"></label>
                <select asp-for="VenueId" class="form-control" asp-items="@(new SelectList(ViewBag.Venues, "Id", "Name"))">
                    <option value="">-- Select a venue --</option>
                </select>
                <span asp-validation-for="VenueId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Equipment Photo (optional)</label>
                <input type="file" name="equipmentPhotoFile" class="form-control" accept=".jpg,.jpeg,.png" />
            </div>

            @await Html.PartialAsync("_PurchaseInfoFields", Model)

            <button type="submit" class="btn btn-gradient">Add Equipment</button>
            <a asp-action="Manage" class="btn btn-outline-primary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
