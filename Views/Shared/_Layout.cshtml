<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dut Gym e-Application</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LoginFormASPCore6.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAuthenticated = Context.Session.GetString("UserSession") != null;
        var currentRole = Context.Session.GetString("UserRole");
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Dut Gym</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Plans" asp-action="Index">Plans</a>
                            </li>
                            @if (currentRole == "Staff")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Staff" asp-action="CheckIn">Check-In</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Equipment" asp-action="Manage">Equipment</a>
                                </li>
                            }
                            @if (currentRole == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="PendingMemberships">Approvals</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Manage</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ActiveMembers">Active Members</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="PendingStaff">Staff Applications</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="PendingTrainers">Trainer Applications</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Reports">Reports</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Plans" asp-action="Manage">Manage Plans</a></li>
                                        <li><a class="dropdown-item" asp-controller="Venues" asp-action="Manage">Manage Venues</a></li>
                                        <li><a class="dropdown-item" asp-controller="Sessions" asp-action="Manage">Manage Sessions</a></li>
                                        <li><a class="dropdown-item" asp-controller="Equipment" asp-action="Manage">Manage Equipment</a></li>
                                        <li><a class="dropdown-item" asp-controller="Gamification" asp-action="ManageChallenges">Manage Challenges</a></li>
                                        <li><a class="dropdown-item" asp-controller="Capacity" asp-action="ManageSlots">Manage Capacity Slots</a></li>
                                    </ul>
                                </li>
                            }
                            @if (currentRole == "Student")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">More</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Trainers" asp-action="Browse">Trainers</a></li>
                                        <li><a class="dropdown-item" asp-controller="Goals" asp-action="MyGoal">My Goals</a></li>
                                        <li><a class="dropdown-item" asp-controller="Goals" asp-action="Leaderboard">Attendance Leaderboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Sessions" asp-action="Browse">Book a Session</a></li>
                                        <li><a class="dropdown-item" asp-controller="Meals" asp-action="Index">Meal Planner</a></li>
                                        <li><a class="dropdown-item" asp-controller="Capacity" asp-action="Index">Live Capacity</a></li>
                                        <li><a class="dropdown-item" asp-controller="Capacity" asp-action="Slots">Book a Slot</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Gamification" asp-action="Profile">Achievements</a></li>
                                        <li><a class="dropdown-item" asp-controller="Gamification" asp-action="Challenges">Challenges</a></li>
                                        <li><a class="dropdown-item" asp-controller="Gamification" asp-action="Friends">Friends</a></li>
                                        <li><a class="dropdown-item" asp-controller="Gamification" asp-action="Leaderboard">XP Leaderboard</a></li>
                                    </ul>
                                </li>
                            }
                            @if (currentRole == "Trainer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Trainers" asp-action="IncomingRequests">Requests</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Trainers" asp-action="MyStudents">My Students</a>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
                <div>
                    @if (isAuthenticated)
                    {
                        <a class="btn btn-outline-primary" asp-area="" asp-controller="Home" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn btn-gradient" asp-area="" asp-controller="Home" asp-action="Login">Login</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Dut Gym e-Application - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

