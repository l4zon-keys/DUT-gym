@model LoginFormASPCore6.Models.TrainerRequest

@{
    ViewData["Title"] = "My Trainer";
    var sessions = ViewBag.Sessions as List<LoginFormASPCore6.Models.TrainerSession>;
    var plans = ViewBag.Plans as List<LoginFormASPCore6.Models.WorkoutPlan>;
}

<div class="py-4">
    <h1 class="mb-4">My Trainer</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model == null)
    {
        <p>You don't have a trainer yet. <a asp-action="Browse">Browse trainers</a> to send a request.</p>
    }
    else if (Model.Status == LoginFormASPCore6.Models.TrainerRequestStatus.Pending)
    {
        <div class="section-card mb-3">
            <p class="mb-2">Request sent to <strong>@Model.Trainer!.EmpName</strong> - waiting for a response.</p>
            <form asp-action="CancelRequest" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-primary">Cancel Request</button>
            </form>
        </div>
    }
    else
    {
        <div class="section-card mb-4">
            <h5 class="mb-1">@Model.Trainer!.EmpName</h5>
            <p class="form-text-hint mb-0">@Model.Trainer.TrainerBio</p>
        </div>

        <h5 class="mb-3">Upcoming Sessions</h5>
        @if (sessions == null || !sessions.Any())
        {
            <p class="text-muted mb-4">No sessions scheduled yet.</p>
        }
        else
        {
            <div class="section-card mb-4 p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var session in sessions)
                    {
                        <li class="list-group-item">
                            @session.ScheduledAt.ToString("f") @(string.IsNullOrWhiteSpace(session.Notes) ? "" : $"- {session.Notes}")
                        </li>
                    }
                </ul>
            </div>
        }

        <h5 class="mb-3">Workout Plans</h5>
        @if (plans == null || !plans.Any())
        {
            <p class="text-muted">No workout plans uploaded yet.</p>
        }
        else
        {
            <div class="section-card p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var plan in plans)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@plan.Title @(string.IsNullOrWhiteSpace(plan.Notes) ? "" : $"- {plan.Notes}")</span>
                            <a href="~/@plan.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">Download</a>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>
