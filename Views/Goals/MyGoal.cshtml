@model LoginFormASPCore6.Models.FitnessGoal

@{
    ViewData["Title"] = "My Goals";
}

<div class="py-4">
    <h1 class="mb-4">My Fitness Goal</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="section-card mb-4">
        <div class="info-row">
            <span class="info-label">Attendance Streak</span>
            <span class="info-value">@ViewBag.Streak month(s)</span>
        </div>
        <div class="info-row">
            <span class="info-label">Visits This Month</span>
            <span class="info-value">@ViewBag.VisitsThisMonth</span>
        </div>
        <div class="info-row">
            <span class="info-label">Days This Week</span>
            <span class="info-value">@ViewBag.DaysThisWeek / 7</span>
        </div>
        <div class="info-row">
            <span class="info-label">Time at the Gym Today</span>
            <span class="info-value">@(((double)ViewBag.TodayMinutes).ToString("0")) min</span>
        </div>
        <div class="info-row">
            <span class="info-label">Average Time Per Visit</span>
            <span class="info-value">@(((double)ViewBag.AverageVisitMinutes).ToString("0")) min</span>
        </div>

        @{
            var daysThisWeek = (int)ViewBag.DaysThisWeek;
            var streak = (int)ViewBag.Streak;
            var visitsThisMonth = (int)ViewBag.VisitsThisMonth;
            var certificateRequiredVisits = (int)ViewBag.CertificateRequiredVisits;
            var certificateEligible = (bool)ViewBag.CertificateEligible;
            var certificateHalfwayVisits = Math.Max(1, certificateRequiredVisits / 2);
            var certificateProgress = Math.Min(100, (int)(100.0 * visitsThisMonth / certificateRequiredVisits));
            var certificateRemainingVisits = Math.Max(0, certificateRequiredVisits - visitsThisMonth);
        }
        <div class="d-flex gap-2 flex-wrap mt-2">
            @if (streak >= 3)
            {
                <span class="status-badge status-active">🔥 @(streak)-month streak</span>
            }
            @if (daysThisWeek >= 3)
            {
                <span class="status-badge status-active">💪 Great consistency this week!</span>
            }
        </div>

        <div class="mt-4 p-3 rounded border">
            <div class="d-flex justify-content-between gap-3 flex-wrap align-items-start">
                <div>
                    <h5 class="mb-1">My Certificate</h5>
                    <p class="form-text-hint mb-2">
                        Complete @certificateRequiredVisits gym visits in the current month to unlock your Certificate of Consistency.
                    </p>
                    <div class="progress-track mb-2">
                        <div class="progress-fill" style="width:@certificateProgress%"></div>
                    </div>
                    <p class="form-text-hint mb-0">
                        @visitsThisMonth / @certificateRequiredVisits visits completed this month
                        @if (!certificateEligible)
                        {
                            <span>- @certificateRemainingVisits more visit(s) to unlock</span>
                        }
                    </p>
                </div>
                <span class="status-badge @(certificateEligible ? "status-active" : "status-pending")">
                    @(certificateEligible ? "Unlocked" : "In Progress")
                </span>
            </div>

            <div class="mt-3">
                <h6 class="mb-2">Certificate Timeline</h6>
                <div class="info-row">
                    <span class="info-label">1. Month started</span>
                    <span class="info-value">Tracking active</span>
                </div>
                <div class="info-row">
                    <span class="info-label">2. Reach @certificateHalfwayVisits visits</span>
                    <span class="info-value">
                        <span class="status-badge @(visitsThisMonth >= certificateHalfwayVisits ? "status-active" : "status-pending")">
                            @(visitsThisMonth >= certificateHalfwayVisits ? "Done" : "Pending")
                        </span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">3. Reach @certificateRequiredVisits visits</span>
                    <span class="info-value">
                        <span class="status-badge @(certificateEligible ? "status-active" : "status-pending")">
                            @(certificateEligible ? "Done" : $"{certificateRemainingVisits} left")
                        </span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">4. View or download certificate</span>
                    <span class="info-value">
                        <span class="status-badge @(certificateEligible ? "status-active" : "status-pending")">
                            @(certificateEligible ? "Available" : "Locked")
                        </span>
                    </span>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2 flex-wrap">
                @if (certificateEligible)
                {
                    <a asp-action="Certificate" class="btn btn-gradient">View My Certificate</a>
                    <a asp-action="DownloadCertificate" class="btn btn-outline-primary">Download Certificate</a>
                }
                else
                {
                    <button type="button" class="btn btn-gradient" disabled>View My Certificate</button>
                    <button type="button" class="btn btn-outline-primary" disabled>Download Certificate</button>
                }
            </div>
        </div>
    </div>

    @if (Model == null)
    {
        <p>You haven't set a fitness goal yet.</p>
        <a asp-action="SetGoal" class="btn btn-gradient">Set a Goal</a>
    }
    else
    {
        <div class="section-card mb-4">
            <h5 class="mb-1">@Model.GoalType</h5>
            <p class="form-text-hint mb-1">@Model.Description</p>
            @if (Model.StartingWeightKg != null)
            {
                <p class="mb-1">Starting: @Model.StartingWeightKg kg @(Model.TargetWeightKg != null ? $"- Target: {Model.TargetWeightKg} kg" : "")</p>
            }

            @{
                var latestWeight = Model.ProgressLogs.OrderByDescending(l => l.LoggedAt).FirstOrDefault(l => l.WeightKg != null)?.WeightKg;
            }
            @if (Model.StartingWeightKg != null && Model.TargetWeightKg != null && latestWeight != null)
            {
                var start = Model.StartingWeightKg.Value;
                var target = Model.TargetWeightKg.Value;
                var current = latestWeight.Value;
                var totalSpan = Math.Abs(target - start);
                var covered = Math.Abs(current - start);
                var pct = totalSpan == 0 ? 100 : (int)Math.Clamp(covered / totalSpan * 100, 0, 100);
                <div class="progress-track mb-3">
                    <div class="progress-fill" style="width:@(pct)%"></div>
                </div>
                <p class="form-text-hint mb-2">@pct% of the way to your target</p>
            }

            <form asp-action="LogProgress" method="post" class="d-flex gap-2 align-items-end mt-3">
                <input type="hidden" name="goalId" value="@Model.Id" />
                <div>
                    <label class="form-label">Weight (kg)</label>
                    <input type="number" step="0.1" min="20" max="300" name="weightKg" class="form-control" required />
                </div>
                <div class="flex-grow-1">
                    <label class="form-label">Notes</label>
                    <input type="text" name="notes" class="form-control" placeholder="Optional" />
                </div>
                <button type="submit" class="btn btn-gradient">Log Progress</button>
            </form>
        </div>

        <h5 class="mb-3">Progress History</h5>
        @if (!Model.ProgressLogs.Any())
        {
            <p class="text-muted">No progress logged yet.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>Date</th><th>Weight (kg)</th><th>Notes</th></tr></thead>
                <tbody>
                    @foreach (var log in Model.ProgressLogs.OrderByDescending(l => l.LoggedAt))
                    {
                        <tr>
                            <td>@log.LoggedAt.ToString("d")</td>
                            <td>@log.WeightKg</td>
                            <td>@log.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>
