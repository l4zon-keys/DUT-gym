@model LoginFormASPCore6.Models.FitnessGoal

@{
    ViewData["Title"] = "Set a Goal";
}

<div class="py-4">
    <div class="section-card mx-auto" style="max-width: 560px;">
        <h1 class="mb-4">Set a Fitness Goal</h1>

        <form asp-action="SetGoal" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="GoalType" class="form-label"></label>
                <select asp-for="GoalType" class="form-control">
                    <option value="WeightLoss">Weight Loss</option>
                    <option value="MuscleGain">Muscle Gain</option>
                    <option value="GeneralFitness">General Fitness</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" placeholder="e.g. Lose 5kg before end of semester" />
            </div>

            <div class="mb-3">
                <label asp-for="StartingWeightKg" class="form-label"></label>
                <input asp-for="StartingWeightKg" type="number" step="0.1" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="TargetWeightKg" class="form-label"></label>
                <input asp-for="TargetWeightKg" type="number" step="0.1" class="form-control" />
            </div>

            <button type="submit" class="btn btn-gradient w-100">Save Goal</button>
        </form>
    </div>
</div>
