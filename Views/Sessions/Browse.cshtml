@model List<LoginFormASPCore6.Models.Session>

@{
    ViewData["Title"] = "Class Schedule";
    var bookingCounts = ViewBag.BookingCounts as Dictionary<int, int>;
    var sessionsByDay = ViewBag.SessionsByDay as List<IGrouping<DateTime, LoginFormASPCore6.Models.Session>>;
    var today = DateTime.UtcNow.Date;
}

<div class="py-4">
    <h1 class="mb-4">Class Schedule</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <p class="mb-4"><a asp-action="MyBookings">View My Bookings</a></p>

    @if (!Model.Any())
    {
        <p class="text-muted">No upcoming sessions scheduled.</p>
    }

    @if (sessionsByDay != null)
    {
        @foreach (var day in sessionsByDay)
        {
            var dayLabel = day.Key == today ? "Today"
                : day.Key == today.AddDays(1) ? "Tomorrow"
                : day.Key.ToString("dddd, d MMMM");

            <h5 class="mt-4 mb-2">@dayLabel</h5>
            @foreach (var session in day)
            {
                var booked = bookingCounts != null && bookingCounts.TryGetValue(session.Id, out var count) ? count : 0;
                var full = booked >= session.Capacity;

                <div class="section-card mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <div class="d-flex gap-2 align-items-center mb-1">
                                <h5 class="mb-0">@session.Title</h5>
                                @if (!string.IsNullOrEmpty(session.Category))
                                {
                                    <span class="status-badge status-active">@session.Category</span>
                                }
                            </div>
                            <p class="form-text-hint mb-1">
                                @session.Venue!.Name - @session.StartTime.ToString("t") to @session.EndTime.ToString("t")
                                @(session.Instructor != null ? $"- with {session.Instructor.EmpName}" : "")
                            </p>
                            <p class="mb-0">@booked / @session.Capacity booked</p>
                        </div>
                        <form asp-action="Book" method="post">
                            <input type="hidden" name="sessionId" value="@session.Id" />
                            <button type="submit" class="btn btn-gradient" @(full ? "disabled" : "")>@(full ? "Full" : "Book")</button>
                        </form>
                    </div>
                </div>
            }
        }
    }
</div>
