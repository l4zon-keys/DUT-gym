@model LoginFormASPCore6.Controllers.RecurringSessionRequest

@{
    ViewData["Title"] = "New Recurring Class";
    var weekdays = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
}

<div class="py-4">
    <div class="section-card mx-auto" style="max-width: 640px;">
        <h1 class="mb-2">New Recurring Class</h1>
        <p class="form-text-hint mb-4">Generates one session per selected weekday, every week, for the number of weeks chosen.</p>
        <form asp-action="CreateRecurring" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Zumba" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="VenueId" class="form-label"></label>
                <select asp-for="VenueId" asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Venues)" class="form-control">
                    <option value="">Select venue</option>
                </select>
                <span asp-validation-for="VenueId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" placeholder="e.g. Aerobics, Zumba, Yoga" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="InstructorUserId" class="form-label"></label>
                <select asp-for="InstructorUserId" asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Instructors)" class="form-control">
                    <option value="">None</option>
                </select>
                <span asp-validation-for="InstructorUserId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Weekdays</label>
                <div class="d-flex gap-3 flex-wrap">
                    @foreach (var day in weekdays)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Weekdays" value="@day" id="day-@day" />
                            <label class="form-check-label" for="day-@day">@day.ToString().Substring(0, 3)</label>
                        </div>
                    }
                </div>
                <span asp-validation-for="Weekdays" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartTime" class="form-label">Start Time (of day)</label>
                <input type="time" name="StartTime" class="form-control" value="18:00" />
            </div>
            <div class="mb-3">
                <label asp-for="EndTime" class="form-label">End Time (of day)</label>
                <input type="time" name="EndTime" class="form-control" value="19:00" />
            </div>
            <div class="mb-3">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="WeeksToGenerate" class="form-label">Weeks to Generate</label>
                <input asp-for="WeeksToGenerate" class="form-control" />
                <span asp-validation-for="WeeksToGenerate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-gradient">Generate Sessions</button>
            <a asp-action="Manage" class="btn btn-outline-primary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
