@model List<LoginFormASPCore6.Models.SessionBooking>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="py-4">
    <h1 class="mb-4">My Bookings</h1>

    <p class="mb-4"><a asp-action="Browse">Browse Sessions</a></p>

    @if (!Model.Any())
    {
        <p class="text-muted">No upcoming bookings.</p>
    }

    @foreach (var booking in Model)
    {
        <div class="section-card mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h5 class="mb-1">@booking.Session!.Title</h5>
                    <p class="form-text-hint mb-0">@booking.Session.Venue!.Name - @booking.Session.StartTime.ToString("f")</p>
                </div>
                <form asp-action="CancelBooking" asp-route-id="@booking.Id" method="post">
                    <button type="submit" class="btn btn-outline-primary">Cancel</button>
                </form>
            </div>
        </div>
    }
</div>
