@model LoginFormASPCore6.Models.User
@using LoginFormASPCore6.Services

@{
    ViewData["Title"] = "Student Dashboard";
    var membership = ViewBag.Membership as Membership;
    var capacity = ViewBag.Capacity as CapacityStatus;
    var streak = (int)ViewBag.Streak;
}

<div class="py-4">
    <div class="dashboard-card mx-auto" style="max-width: 640px;">
        <div class="dashboard-banner">
            <span class="role-badge">Student</span>
            <h1>Welcome, @Model.EmpName</h1>
            <p>This is your DUT Gym membership overview.</p>
        </div>
        <div class="dashboard-body">
            @if (capacity != null)
            {
                <div class="mb-3">
                    <partial name="_CapacityBadge" model="capacity" />
                </div>
            }

            @if (streak >= 3)
            {
                <div class="mb-3">
                    <span class="status-badge status-active"><i class="bi bi-fire"></i> @(streak)-month streak</span>
                </div>
            }

            <div class="mb-3">
                @await Html.PartialAsync("_XpLevelBadge", (XpLevelSummary)ViewBag.XpSummary)
            </div>

            <div class="info-row">
                <span class="info-label"><i class="bi bi-person"></i>Full Name</span>
                <span class="info-value">@Model.EmpName</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-card-text"></i>Student Number</span>
                <span class="info-value">@Model.StudentNumber</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-envelope"></i>Email</span>
                <span class="info-value">@Model.Email</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-award"></i>Membership Plan</span>
                <span class="info-value">@(membership?.Plan?.Name ?? "-")</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-shield-check"></i>Membership Status</span>
                <span class="info-value">
                    @if (membership == null)
                    {
                        <span>Not applied</span>
                    }
                    else
                    {
                        var statusClass = membership.Status == MembershipStatus.Active ? "status-active"
                            : membership.Status == MembershipStatus.Pending ? "status-pending" : "status-rejected";
                        <span class="status-badge @statusClass">@membership.Status</span>
                    }
                </span>
            </div>

            <div class="mt-4 d-flex gap-2 flex-wrap">
                <a asp-controller="Plans" asp-action="Index" class="btn btn-outline-primary">Browse Plans</a>
                @if (membership == null || membership.Status == MembershipStatus.Rejected)
                {
                    <a asp-controller="Membership" asp-action="Apply" class="btn btn-gradient">Apply for Membership</a>
                }
                else
                {
                    <a asp-controller="Membership" asp-action="Status" class="btn btn-gradient">View Membership Status</a>
                }
                <a asp-controller="Goals" asp-action="MyGoal" class="btn btn-outline-primary">My Fitness Goal</a>
                <a asp-controller="Trainers" asp-action="MyTrainer" class="btn btn-outline-primary">My Trainer &amp; Plans</a>
                <a asp-controller="Sessions" asp-action="Browse" class="btn btn-outline-primary">Class Schedule</a>
                <a asp-controller="Meals" asp-action="Index" class="btn btn-outline-primary">Meal Planner</a>
                <a asp-controller="Gamification" asp-action="Profile" class="btn btn-outline-primary">Achievements</a>
            </div>
        </div>
    </div>
</div>

