@model LoginFormASPCore6.Models.User
@using LoginFormASPCore6.Services

@{
    ViewData["Title"] = "Staff Dashboard";
    var capacity = ViewBag.Capacity as CapacityStatus;
    var checkInsToday = (int)ViewBag.CheckInsToday;
    var faultyEquipmentCount = (int)ViewBag.FaultyEquipmentCount;
}

<div class="py-4">
    <div class="dashboard-card mx-auto" style="max-width: 720px;">
        <div class="dashboard-banner">
            <span class="role-badge">Staff</span>
            <h1>Welcome, @Model.EmpName</h1>
            <p>This is your DUT Gym staff account overview.</p>
        </div>
        <div class="dashboard-body">
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="stat-tile">
                        <span class="stat-tile-icon"><i class="bi bi-door-open"></i></span>
                        <div>
                            <div class="stat-tile-label">Check-Ins Today</div>
                            <div class="stat-tile-value">@checkInsToday</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-tile">
                        <span class="stat-tile-icon"><i class="bi bi-people"></i></span>
                        <div>
                            <div class="stat-tile-label">Current Occupancy</div>
                            <div class="stat-tile-value">@(capacity?.CurrentOccupancy ?? 0)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-tile">
                        <span class="stat-tile-icon"><i class="bi bi-exclamation-triangle"></i></span>
                        <div>
                            <div class="stat-tile-label">Equipment Faults</div>
                            <div class="stat-tile-value">@faultyEquipmentCount</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="info-row">
                <span class="info-label"><i class="bi bi-person"></i>Full Name</span>
                <span class="info-value">@Model.EmpName</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-gender-ambiguous"></i>Gender</span>
                <span class="info-value">@Model.Gender</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-envelope"></i>Email</span>
                <span class="info-value">@Model.Email</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-person-badge"></i>Role</span>
                <span class="info-value">Staff</span>
            </div>

            <div class="mt-4 d-flex gap-2 flex-wrap">
                <a asp-controller="Staff" asp-action="CheckIn" class="btn btn-gradient">Check-In Desk</a>
                <a asp-controller="Staff" asp-action="Capacity" class="btn btn-outline-primary">Gym Capacity</a>
                <a asp-controller="Equipment" asp-action="Manage" class="btn btn-outline-primary">Equipment</a>
            </div>
        </div>
    </div>
</div>
