@model LoginFormASPCore6.Models.User

@{
    ViewData["Title"] = "Application Pending";
}

<div class="py-4">
    <div class="dashboard-card mx-auto" style="max-width: 640px;">
        <div class="dashboard-banner">
            <span class="role-badge">Trainer</span>
            <h1>Welcome, @Model.EmpName</h1>
        </div>
        <div class="dashboard-body">
            @if (Model.TrainerApprovalStatus == LoginFormASPCore6.Models.TrainerApprovalStatus.Rejected)
            {
                <p>Your trainer application was not approved. Contact the gym admin for details.</p>
            }
            else
            {
                <p>Your trainer application is awaiting admin approval. You'll get access to the trainer portal once approved - check back later.</p>
            }
        </div>
    </div>
</div>
