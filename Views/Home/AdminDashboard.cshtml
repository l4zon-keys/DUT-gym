@model LoginFormASPCore6.Models.User

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="py-4">
    <div class="dashboard-card mx-auto" style="max-width: 640px;">
        <div class="dashboard-banner">
            <span class="role-badge">Admin</span>
            <h1>Welcome, @Model.EmpName</h1>
            <p>This is your DUT Gym admin overview.</p>
        </div>
        <div class="dashboard-body">
            <div class="info-row">
                <span class="info-label">Full Name</span>
                <span class="info-value">@Model.EmpName</span>
            </div>
            <div class="info-row">
                <span class="info-label">Email</span>
                <span class="info-value">@Model.Email</span>
            </div>
            <div class="info-row">
                <span class="info-label">Role</span>
                <span class="info-value">Admin</span>
            </div>

            <div class="mt-4 d-flex gap-2 flex-wrap">
                <a asp-controller="Admin" asp-action="PendingMemberships" class="btn btn-gradient">Pending Applications</a>
                <a asp-controller="Admin" asp-action="ActiveMembers" class="btn btn-outline-primary">Active Members</a>
                <a asp-controller="Admin" asp-action="PendingStaff" class="btn btn-outline-primary">Staff Applications</a>
                <a asp-controller="Admin" asp-action="PendingTrainers" class="btn btn-outline-primary">Trainer Applications</a>
                <a asp-controller="Admin" asp-action="Reports" class="btn btn-outline-primary">Reports</a>
                <a asp-controller="Plans" asp-action="Manage" class="btn btn-outline-primary">Manage Plans</a>
                <a asp-controller="Venues" asp-action="Manage" class="btn btn-outline-primary">Manage Venues</a>
                <a asp-controller="Sessions" asp-action="Manage" class="btn btn-outline-primary">Manage Sessions</a>
            </div>
        </div>
    </div>
</div>
