@model List<LoginFormASPCore6.Models.User>

@{
    ViewData["Title"] = "Pending Staff Applications";
}

<div class="py-4">
    <h1 class="mb-4">Pending Staff Applications</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">No staff applications waiting for review.</p>
    }

    @foreach (var staff in Model)
    {
        <div class="section-card mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h5 class="mb-1">@staff.EmpName <span class="form-text-hint">(@staff.StudentNumber)</span></h5>
                    <p class="form-text-hint mb-0">@staff.Email</p>
                </div>
                <div class="d-flex gap-2">
                    <form asp-action="ReviewStaff" asp-route-id="@staff.Id" method="post">
                        <input type="hidden" name="approve" value="true" />
                        <button type="submit" class="btn btn-gradient">Approve</button>
                    </form>
                    <form asp-action="ReviewStaff" asp-route-id="@staff.Id" method="post">
                        <input type="hidden" name="approve" value="false" />
                        <button type="submit" class="btn btn-outline-primary">Reject</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
