@model List<Membership>

@{
    ViewData["Title"] = "Active Members";
}

<div class="py-4">
    <h1 class="mb-4">Active Members</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form method="get" class="d-flex gap-2 mb-4" style="max-width: 480px;">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Search by name, student number, or email" />
        <button type="submit" class="btn btn-gradient">Search</button>
    </form>

    @if (!Model.Any())
    {
        <p class="text-muted">No active members @(ViewBag.Query != null ? "matched that search" : "yet").</p>
    }
    else
    {
        <div class="section-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Student Number</th>
                        <th>Plan</th>
                        <th>Trainer</th>
                        <th>Expires</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var membership in Model)
                    {
                        <tr>
                            <td>@membership.User!.EmpName</td>
                            <td>@membership.User.StudentNumber</td>
                            <td>@membership.Plan!.Name</td>
                            <td>@(membership.PersonalTrainerOption == PersonalTrainerOption.None ? "-" : PersonalTrainerPricing.GetLabel(membership.PersonalTrainerOption))</td>
                            <td>@membership.ExpiryDate?.ToString("d")</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end align-items-center flex-wrap">
                                    <a asp-action="EditMembership" asp-route-id="@membership.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form asp-action="DeactivateMembership" asp-route-id="@membership.Id" method="post" class="d-flex gap-1">
                                        <input type="text" name="reason" class="form-control form-control-sm" placeholder="Reason" style="width: 120px;" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @{
        var recentlyDeactivated = (List<Membership>)ViewBag.RecentlyDeactivated;
    }
    @if (recentlyDeactivated.Any())
    {
        <h4 class="mt-5 mb-3">Recently Deactivated</h4>
        <p class="form-text-hint mb-3">Deactivated by mistake? Reactivate it here.</p>

        @foreach (var membership in recentlyDeactivated)
        {
            <div class="section-card mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <h6 class="mb-1">@membership.User!.EmpName <span class="form-text-hint">(@membership.User.StudentNumber)</span></h6>
                        <p class="mb-1">@membership.Plan!.Name</p>
                        <p class="form-text-hint mb-0">Reason: @membership.StatusNote</p>
                    </div>
                    <form asp-action="ReactivateMembership" asp-route-id="@membership.Id" method="post">
                        <button type="submit" class="btn btn-outline-primary">Reactivate</button>
                    </form>
                </div>
            </div>
        }
    }
</div>
