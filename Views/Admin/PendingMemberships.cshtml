@model List<Membership>

@{
    ViewData["Title"] = "Pending Memberships";
}

<div class="py-4">
    <h1 class="mb-4">Pending Memberships</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">Nothing waiting for review right now.</p>
    }

    @foreach (var membership in Model)
    {
        var latestPayment = membership.Payments.OrderByDescending(p => p.SubmittedAt).FirstOrDefault();

        <div class="section-card mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h5 class="mb-1">@membership.User!.EmpName <span class="form-text-hint">(@membership.User.StudentNumber)</span></h5>
                    <p class="mb-1">@membership.Plan!.Name - R@(membership.Plan.Price.ToString("0.00"))</p>
                    @if (membership.PersonalTrainerOption != PersonalTrainerOption.None)
                    {
                        <p class="mb-1">@PersonalTrainerPricing.GetLabel(membership.PersonalTrainerOption)</p>
                    }
                    <p class="mb-1"><strong>Total: R@(membership.TotalCost.ToString("0.00"))</strong></p>
                    <p class="form-text-hint mb-1">Campus: @membership.Campus</p>
                    <p class="form-text-hint mb-1">Emergency contact: @membership.EmergencyContactName (@membership.EmergencyContactPhone)</p>
                    @if (!string.IsNullOrWhiteSpace(membership.MedicalConditions))
                    {
                        <p class="form-text-hint mb-1">Medical: @membership.MedicalConditions</p>
                    }
                    <p class="form-text-hint mb-1">Applied: @membership.AppliedAt.ToString("g")</p>

                    @if (!string.IsNullOrEmpty(membership.ProofOfRegistrationFilePath))
                    {
                        <p class="mb-1">
                            Proof of registration:
                            <a href="~/@membership.ProofOfRegistrationFilePath" target="_blank">View file</a>
                        </p>
                    }

                    @if (latestPayment == null)
                    {
                        <p class="mt-2 mb-0"><em>No payment method chosen yet.</em></p>
                    }
                    else
                    {
                        <p class="mt-2 mb-0">Payment: @latestPayment.Method, R@(latestPayment.Amount.ToString("0.00")), ref @latestPayment.Reference (@latestPayment.Status)</p>
                    }
                </div>

                @{
                    var canConfirmCash = latestPayment != null && latestPayment.Method == PaymentMethod.Cash && latestPayment.Status == PaymentStatus.Pending;
                }
                <div class="d-flex flex-column gap-2" style="min-width: 220px;">
                    <form asp-action="ReviewMembership" asp-route-id="@membership.Id" method="post">
                        <input type="hidden" name="approve" value="true" />
                        <button type="submit" class="btn btn-gradient w-100" @(canConfirmCash ? "" : "disabled")>Confirm Cash Payment</button>
                    </form>
                    <form asp-action="ReviewMembership" asp-route-id="@membership.Id" method="post">
                        <input type="hidden" name="approve" value="false" />
                        <input type="text" name="reason" class="form-control form-control-sm mb-2" placeholder="Rejection reason" />
                        <button type="submit" class="btn btn-outline-primary w-100">Reject</button>
                    </form>
                </div>
            </div>
        </div>
    }

    @{
        var recentlyRejected = (List<Membership>)ViewBag.RecentlyRejected;
    }
    @if (recentlyRejected.Any())
    {
        <h4 class="mt-5 mb-3">Recently Rejected</h4>
        <p class="form-text-hint mb-3">Rejected an application by mistake? Reopen it here to send it back for review.</p>

        @foreach (var membership in recentlyRejected)
        {
            <div class="section-card mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <h6 class="mb-1">@membership.User!.EmpName <span class="form-text-hint">(@membership.User.StudentNumber)</span></h6>
                        <p class="mb-1">@membership.Plan!.Name</p>
                        <p class="form-text-hint mb-0">Reason: @membership.StatusNote</p>
                    </div>
                    <form asp-action="UndoRejection" asp-route-id="@membership.Id" method="post">
                        <button type="submit" class="btn btn-outline-primary">Undo Rejection</button>
                    </form>
                </div>
            </div>
        }
    }
</div>
