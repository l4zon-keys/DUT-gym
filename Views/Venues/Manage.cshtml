@model List<Venue>

@{
    ViewData["Title"] = "Manage Venues";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Venues</h1>
        <a asp-action="Create" class="btn btn-gradient">New Venue</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="section-card">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Location</th>
                    <th>Capacity</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venue in Model)
                {
                    <tr>
                        <td>@venue.Name</td>
                        <td>@venue.Location</td>
                        <td>@venue.Capacity</td>
                        <td>
                            <span class="status-badge @(venue.IsActive ? "status-active" : "status-expired")">
                                @(venue.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@venue.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@venue.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    @(venue.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
