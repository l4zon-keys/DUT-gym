@model Membership

@{
    ViewData["Title"] = "Upload Proof of Payment";
}

<div class="py-4">
    <div class="section-card mx-auto" style="max-width: 560px;">
        <h1 class="mb-1">Upload Proof of Payment</h1>
        <p class="form-text-hint mb-1">@Model.Plan!.Name - R@(Model.Plan.Price.ToString("0.00"))</p>
        @if (Model.PersonalTrainerOption != PersonalTrainerOption.None)
        {
            <p class="form-text-hint mb-1">@PersonalTrainerPricing.GetLabel(Model.PersonalTrainerOption)</p>
        }
        <p class="mb-4"><strong>Total: R@(Model.TotalCost.ToString("0.00"))</strong></p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" asp-validation-summary="All"></div>
        }

        <div class="alert alert-info">
            <strong>Pay via EFT to:</strong><br />
            Bank: @ViewBag.GymBanking["BankName"]<br />
            Account Name: @ViewBag.GymBanking["AccountName"]<br />
            Account Number: @ViewBag.GymBanking["AccountNumber"]<br />
            Branch Code: @ViewBag.GymBanking["BranchCode"]<br />
            <span class="form-text-hint">@ViewBag.GymBanking["ReferenceHint"]</span>
        </div>

        <form asp-action="UploadProof" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">Bank receipt / proof of payment</label>
                <input type="file" name="proofFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
                <div class="form-text-hint mt-1">PDF, JPG, or PNG. Max 5MB.</div>
            </div>

            <button type="submit" class="btn btn-gradient w-100">Submit for Review</button>
        </form>
    </div>
</div>
