@model Membership

@{
    ViewData["Title"] = "Pay for Membership";
}

<div class="py-4">
    <div class="section-card mx-auto" style="max-width: 560px;">
        <h1 class="mb-1">Pay for Your Membership</h1>
        <p class="form-text-hint mb-1">@Model.Plan!.Name - R@(Model.Plan.Price.ToString("0.00")) for @Model.Plan.DurationMonths month(s)</p>
        @if (Model.PersonalTrainerOption != PersonalTrainerOption.None)
        {
            <p class="form-text-hint mb-1">@PersonalTrainerPricing.GetLabel(Model.PersonalTrainerOption)</p>
        }
        <p class="mb-4"><strong>Total: R@(Model.TotalCost.ToString("0.00"))</strong></p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form asp-action="Checkout" asp-route-id="@Model.Id" method="post">
            @await Html.PartialAsync("_PaymentMethodPicker")
            <button type="submit" class="btn btn-gradient w-100 mt-3">Pay</button>
        </form>
    </div>
</div>
